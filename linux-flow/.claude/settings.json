{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cat | bash /home/abdulrahmanchibon/Hani-pro/linux-flow/.claude/hooks/check.sh",
            "statusMessage": "fmt → clippy → line-count..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/abdulrahmanchibon/Hani-pro/linux-flow/.claude/hooks/full-check.sh",
            "statusMessage": "build → test → doc → audit → deny..."
          },
          {
            "type": "command",
            "command": "bash /home/abdulrahmanchibon/Hani-pro/linux-flow/.claude/hooks/update_memory.sh",
            "statusMessage": "updating memory..."
          }
        ]
      }
    ]
  }
}
