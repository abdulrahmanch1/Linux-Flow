[Unit]
Description=linux-flow Privileged Input Helper
After=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/local/lib/linux-flow/linux-flow-helper
PassEnvironment=WAYLAND_DISPLAY DISPLAY
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
